---
import {client} from "../data/client";

const address = client.address;
---

<dialog
  id="warehouse-move-dialog"
  aria-labelledby="warehouse-move-title"
  class="m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-xl overflow-y-auto rounded-xl border border-border bg-background p-0 text-text shadow-2xl backdrop:bg-primary/70"
>
  <div class="bg-primary px-6 pb-6 pt-5 text-primary-fg sm:px-8 sm:pt-7">
    <div class="flex items-start justify-between gap-4">
      <p class="text-sm font-bold uppercase text-accent">Aviso importante</p>
      <button
        type="button"
        data-close-warehouse-dialog
        aria-label="Cerrar aviso"
        class="-mr-2 -mt-2 inline-flex size-10 shrink-0 items-center justify-center rounded-md text-primary-fg transition hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
    <h2 id="warehouse-move-title" class="mt-3 font-heading text-3xl font-extrabold leading-tight sm:text-4xl">
      ¡Nos mudamos a un almacén más grande!
    </h2>
    <p class="mt-3 max-w-prose text-base leading-relaxed text-white/90">
      Para seguir brindándote un mejor servicio, desde el lunes 5 de octubre recibiremos tus compras en esta nueva dirección:
    </p>
  </div>

  <div class="space-y-4 p-5 sm:p-7">
    <div class="flex items-center gap-4 rounded-lg border border-border bg-surface p-4 sm:p-5">
      <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-white text-primary" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="5" width="18" height="16" rx="2" />
          <path stroke-linecap="round" d="M7 3v4m10-4v4M3 10h18M8 14h2m4 0h2m-8 3h2m4 0h2" />
        </svg>
      </span>
      <div>
        <p class="text-sm font-semibold text-text-muted">A partir del lunes 5 de octubre</p>
        <p class="mt-0.5 font-bold text-primary">Recibimos tus compras en:</p>
      </div>
    </div>

    <div class="flex items-center gap-4 rounded-lg bg-primary px-4 py-5 text-primary-fg sm:px-6">
      <svg viewBox="0 0 24 24" class="size-9 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
        <circle cx="12" cy="10" r="2.5" />
      </svg>
      <address class="not-italic text-lg font-extrabold uppercase leading-snug sm:text-xl">
        {address.lineOne}<br />{address.city}, {address.state} {address.zip}
      </address>
    </div>

    <div
      id="warehouse-move-transition-note"
      class="flex gap-3 rounded-lg border border-border bg-surface px-4 py-4"
    >
      <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-accent text-accent-fg" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 3.9 1.8 18.5A1.7 1.7 0 0 0 3.3 21h17.4a1.7 1.7 0 0 0 1.5-2.5L13.7 3.9a2 2 0 0 0-3.4 0Z" />
        </svg>
      </span>
      <p class="text-sm leading-relaxed text-text">
        ¿Tu paquete ya está en camino y el transportista indica que llegará antes del viernes? Mantén la dirección original para ese envío.
      </p>
    </div>

    <p class="text-sm leading-relaxed text-text-muted">
      Si ya tienes un pedido en tránsito, verifica la fecha estimada de entrega antes de actualizar la dirección guardada en la tienda.
    </p>
  </div>
</dialog>

<script>
  const initializeWarehouseMoveDialog = () => {
    const dialog = document.querySelector<HTMLDialogElement>("#warehouse-move-dialog");
    if (!dialog || dialog.dataset.initialized === "true") return;

    dialog.dataset.initialized = "true";
    const storageKey = "caricoxpress-warehouse-move-dismissed-v1";
    const expiresAt = new Date("2026-10-06T00:00:00-04:00").getTime();
    const transitionEndsAt = new Date("2026-10-02T00:00:00-04:00").getTime();
    const transitionNote = document.querySelector("#warehouse-move-transition-note");

    if (Date.now() >= transitionEndsAt) transitionNote?.remove();
    if (Date.now() >= expiresAt) return;

    try {
      if (localStorage.getItem(storageKey) === "true") return;
    } catch {
      // The dialog can still be dismissed for the current page if storage is unavailable.
    }

    dialog.querySelector<HTMLButtonElement>("[data-close-warehouse-dialog]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      try {
        localStorage.setItem(storageKey, "true");
      } catch {
        // Keep the close action functional when storage is unavailable.
      }
    });

    dialog.showModal();
  };

  document.addEventListener("astro:page-load", initializeWarehouseMoveDialog);
  initializeWarehouseMoveDialog();
</script>
