<script>
  const initializeLockerPage = () => {
    interface ShippingData {
      warehouse_reference: string;
      address_line_1: string;
      city: string;
      state: string;
      postal_code: string;
      country: string;
    }

    interface LockerAccessResponse {
      customer_name: string;
      locker_code: string;
      shipping_data: ShippingData;
    }

    interface PreAlertHistoryItem {
      date: string;
      external_tracking: string;
      content_description: string | null;
      declared_value: string | number | null;
      shipping_type: string;
    }

    const publicApiUrl = import.meta.env.PUBLIC_API_URL;
    const accessEndpoint = publicApiUrl
      ? `${publicApiUrl.replace(/\/$/, "")}/api/public/locker-access`
      : "";
    const sessionEndpoint = publicApiUrl
      ? `${publicApiUrl.replace(/\/$/, "")}/api/public/locker-access/me`
      : "";
    const logoutEndpoint = publicApiUrl
      ? `${publicApiUrl.replace(/\/$/, "")}/api/public/locker-access/logout`
      : "";
    const preAlertEndpoint = publicApiUrl
      ? `${publicApiUrl.replace(/\/$/, "")}/api/public/pre-alerts`
      : "";
    const invalidCredentialsMessage =
      "El correo o la contraseña no son correctos.";
    const rateLimitMessage =
      "Has realizado varios intentos en poco tiempo. Espera un momento antes de intentar nuevamente.";
    const genericErrorMessage =
      "No pudimos consultar tu casillero en este momento. Intenta nuevamente más tarde.";

    const accessPanel = document.getElementById("access-panel");
    const form = document.getElementById("locker-access-form");
    const submitButton = document.getElementById("access-submit");
    const status = document.getElementById("access-status");
    const accessError = document.getElementById("access-error");
    const successMessage = document.getElementById(
      "registration-success-message",
    );
    const idleLabel = form?.querySelector("[data-label-idle]");
    const loadingLabel = form?.querySelector("[data-label-loading]");
    const content = document.getElementById("locker-content");
    const cardLockerCode = document.getElementById("card-locker-code-header");
    const closeLockerButton = document.getElementById("close-locker");
    const preAlertForm = document.getElementById("prealert-form");
    const preAlertSubmitButton = document.getElementById("prealert-submit");
    const preAlertSuccess = document.getElementById("prealert-success");
    const preAlertError = document.getElementById("prealert-error");
    const preAlertErrorMessage = document.getElementById(
      "prealert-error-message",
    );
    const preAlertLoginAction = document.getElementById(
      "prealert-login-action",
    );
    const preAlertIdleLabel = preAlertForm?.querySelector(
      "[data-prealert-idle]",
    );
    const preAlertLoadingLabel = preAlertForm?.querySelector(
      "[data-prealert-loading]",
    );
    const preAlertHistoryLoading = document.getElementById(
      "prealert-history-loading",
    );
    const preAlertHistoryEmpty = document.getElementById(
      "prealert-history-empty",
    );
    const preAlertHistoryError = document.getElementById(
      "prealert-history-error",
    );
    const preAlertHistoryTableWrap = document.getElementById(
      "prealert-history-table-wrap",
    );
    const preAlertHistoryRows = document.getElementById(
      "prealert-history-rows",
    );
    const copyCustomerCodeButton =
      document.getElementById("copy-customer-code");
    const copyCustomerCodeStatus = document.getElementById(
      "copy-customer-code-status",
    );

    if (!(form instanceof HTMLFormElement)) return;
    if (!(submitButton instanceof HTMLButtonElement)) return;

    const initializePasswordToggles = () => {
      document
        .querySelectorAll("[data-password-toggle]")
        .forEach((toggle: Element) => {
          if (!(toggle instanceof HTMLButtonElement)) return;
          if (toggle.dataset.passwordToggleInitialized === "true") return;

          const inputId = toggle.dataset.passwordToggle;
          if (!inputId) return;

          const input = document.getElementById(inputId);
          if (!(input instanceof HTMLInputElement)) return;

          const showIcon = toggle.querySelector("[data-password-show-icon]");
          const hideIcon = toggle.querySelector("[data-password-hide-icon]");

          const updateToggleState = (isVisible: boolean) => {
            toggle.setAttribute(
              "aria-label",
              isVisible ? "Ocultar contraseña" : "Mostrar contraseña",
            );
            toggle.setAttribute(
              "title",
              isVisible ? "Ocultar contraseña" : "Mostrar contraseña",
            );
            toggle.setAttribute("aria-pressed", isVisible ? "true" : "false");
            showIcon?.classList.toggle("hidden", isVisible);
            hideIcon?.classList.toggle("hidden", !isVisible);
          };

          toggle.addEventListener("click", () => {
            const shouldShowPassword = input.type === "password";
            input.type = shouldShowPassword ? "text" : "password";
            updateToggleState(shouldShowPassword);
          });

          updateToggleState(input.type === "text");
          toggle.dataset.passwordToggleInitialized = "true";
        });
    };

    initializePasswordToggles();

    if (
      new URLSearchParams(window.location.search).get("registro") === "exitoso"
    ) {
      successMessage?.classList.remove("hidden");
    }

    const setLoading = (isLoading: boolean) => {
      submitButton.disabled = isLoading;
      idleLabel?.classList.toggle("hidden", isLoading);
      loadingLabel?.classList.toggle("hidden", !isLoading);
      if (status) {
        status.textContent = isLoading ? "Consultando..." : "";
      }
    };

    const setError = (message: string) => {
      if (accessError) {
        accessError.textContent = message;
        accessError.classList.remove("hidden");
      }
    };

    const clearErrors = () => {
      accessError?.classList.add("hidden");
      form.querySelectorAll('[id$="-error"]').forEach((error: Element) => {
        error.classList.add("hidden");
      });
      form.querySelectorAll("[aria-invalid]").forEach((field: Element) => {
        field.removeAttribute("aria-invalid");
      });
    };

    const showNativeFieldErrors = () => {
      const fields = form.querySelectorAll("input");
      fields.forEach((field: Element) => {
        if (!(field instanceof HTMLInputElement)) return;
        if (field.validity.valid) return;
        field.setAttribute("aria-invalid", "true");
        document
          .getElementById(`${field.id}-error`)
          ?.classList.remove("hidden");
      });
    };

    const readJsonResponse = async (
      response: Response,
    ): Promise<unknown | null> => {
      try {
        return await response.json();
      } catch {
        return null;
      }
    };

    const isRecord = (value: unknown): value is Record<string, unknown> =>
      value !== null && typeof value === "object";
    const isString = (value: unknown): value is string =>
      typeof value === "string";
    const hasString = (value: unknown): value is string =>
      isString(value) && value.trim().length > 0;

    const isValidShippingData = (value: unknown): value is ShippingData => {
      if (!isRecord(value)) return false;

      return (
        hasString(value.warehouse_reference) &&
        hasString(value.address_line_1) &&
        hasString(value.city) &&
        hasString(value.state) &&
        hasString(value.postal_code) &&
        hasString(value.country)
      );
    };

    const isValidLockerResponse = (
      data: unknown,
    ): data is LockerAccessResponse => {
      if (!isRecord(data)) return false;
      if (!hasString(data.customer_name) || !hasString(data.locker_code)) {
        return false;
      }
      if (!isValidShippingData(data.shipping_data)) return false;

      return true;
    };

    const setText = (id: string, value: unknown) => {
      const element = document.getElementById(id);
      if (element) {
        element.textContent = typeof value === "string" ? value : "";
      }
    };

    const showPreAlertError = (message: string, isExpiredSession = false) => {
      if (preAlertErrorMessage) preAlertErrorMessage.textContent = message;
      preAlertError?.classList.remove("hidden");
      preAlertSuccess?.classList.add("hidden");
      preAlertLoginAction?.classList.toggle("hidden", !isExpiredSession);
    };

    const setPreAlertLoading = (isLoading: boolean) => {
      if (preAlertSubmitButton instanceof HTMLButtonElement) {
        preAlertSubmitButton.disabled = isLoading;
      }
      preAlertIdleLabel?.classList.toggle("hidden", isLoading);
      preAlertLoadingLabel?.classList.toggle("hidden", !isLoading);
    };

    const loadPreAlertHistory = async () => {
      if (!(preAlertHistoryRows instanceof HTMLTableSectionElement)) return;

      preAlertHistoryLoading?.classList.remove("hidden");
      preAlertHistoryEmpty?.classList.add("hidden");
      preAlertHistoryError?.classList.add("hidden");
      preAlertHistoryTableWrap?.classList.add("hidden");
      preAlertHistoryRows.replaceChildren();

      try {
        const response = await fetch(preAlertEndpoint, {
          headers: {Accept: "application/json"},
          credentials: "include",
        });

        if (response.status === 401) {
          showPreAlertError(
            "Tu sesión expiró. Vuelve a iniciar sesión para consultar tus prealertas.",
            true,
          );
          return;
        }

        if (!response.ok) {
          throw new Error("No se pudo cargar el historial de prealertas.");
        }

        const data = await readJsonResponse(response);
        if (!isRecord(data) || !Array.isArray(data.prealerts)) {
          throw new Error("No se pudo cargar el historial de prealertas.");
        }

        const isPreAlertHistoryItem = (
          item: unknown,
        ): item is PreAlertHistoryItem =>
          isRecord(item) &&
          hasString(item.date) &&
          hasString(item.external_tracking) &&
          (item.content_description === null ||
            isString(item.content_description)) &&
          (item.declared_value === null ||
            isString(item.declared_value) ||
            typeof item.declared_value === "number") &&
          hasString(item.shipping_type);

        if (!data.prealerts.every(isPreAlertHistoryItem)) {
          throw new Error("No se pudo cargar el historial de prealertas.");
        }
        const items = data.prealerts as PreAlertHistoryItem[];

        if (items.length === 0) {
          preAlertHistoryEmpty?.classList.remove("hidden");
          return;
        }

        const shippingTypeLabels: Record<string, string> = {
          air: "Aéreo",
          sea: "Marítimo",
          undefined: "Por definir",
        };
        const dateFormatter = new Intl.DateTimeFormat("es-VE", {
          dateStyle: "medium",
        });
        const currencyFormatter = new Intl.NumberFormat("es-VE", {
          style: "currency",
          currency: "USD",
        });

        items.forEach((item) => {
          const row = document.createElement("tr");
          row.className = "align-top even:bg-surface/50";
          const date = new Date(item.date);
          const declaredValue = Number(item.declared_value);
          const cells = [
            Number.isNaN(date.getTime()) ? "—" : dateFormatter.format(date),
            item.external_tracking,
            item.content_description || "—",
            item.declared_value !== null && Number.isFinite(declaredValue)
              ? currencyFormatter.format(declaredValue)
              : "—",
            shippingTypeLabels[item.shipping_type] ?? item.shipping_type,
          ];

          cells.forEach((value) => {
            const cell = document.createElement("td");
            cell.className = "px-4 py-3 text-text";
            cell.textContent = value;
            row.append(cell);
          });

          preAlertHistoryRows.append(row);
        });

        preAlertHistoryTableWrap?.classList.remove("hidden");
      } catch {
        if (preAlertHistoryError) {
          preAlertHistoryError.textContent =
            "No se pudo cargar el historial. Intenta nuevamente más tarde.";
          preAlertHistoryError.classList.remove("hidden");
        }
      } finally {
        preAlertHistoryLoading?.classList.add("hidden");
      }
    };

    if (
      preAlertForm instanceof HTMLFormElement &&
      preAlertSubmitButton instanceof HTMLButtonElement
    ) {
      const trackingField = document.getElementById("prealert-tracking");
      const descriptionField = document.getElementById("prealert-description");
      const valueField = document.getElementById("prealert-value");
      const shippingTypeField = document.getElementById(
        "prealert-shipping-type",
      );
      const descriptionError = document.getElementById(
        "prealert-description-error",
      );
      const trackingError = document.getElementById("prealert-tracking-error");
      const valueError = document.getElementById("prealert-value-error");

      trackingField?.addEventListener("input", () => {
        if (!(trackingField instanceof HTMLInputElement)) return;
        if (!trackingField.value.trim()) return;
        trackingField.removeAttribute("aria-invalid");
        trackingError?.classList.add("hidden");
      });

      descriptionField?.addEventListener("input", () => {
        if (!(descriptionField instanceof HTMLTextAreaElement)) return;
        if (!descriptionField.value.trim()) return;
        descriptionField.removeAttribute("aria-invalid");
        descriptionError?.classList.add("hidden");
      });

      valueField?.addEventListener("input", () => {
        if (!(valueField instanceof HTMLInputElement)) return;
        const value = Number(valueField.value);
        if (!Number.isFinite(value) || value <= 0) return;
        valueField.removeAttribute("aria-invalid");
        valueError?.classList.add("hidden");
      });

      preAlertForm.addEventListener("submit", async (event: Event) => {
        event.preventDefault();
        if (preAlertSubmitButton.disabled) return;

        preAlertError?.classList.add("hidden");
        preAlertLoginAction?.classList.add("hidden");
        preAlertSuccess?.classList.add("hidden");
        trackingError?.classList.add("hidden");
        descriptionError?.classList.add("hidden");
        valueError?.classList.add("hidden");

        if (!(trackingField instanceof HTMLInputElement)) return;
        if (!(descriptionField instanceof HTMLTextAreaElement)) return;
        if (!(valueField instanceof HTMLInputElement)) return;
        if (!(shippingTypeField instanceof HTMLSelectElement)) return;

        const contentDescription = descriptionField.value.trim();
        const declaredValue = Number(valueField.value);
        const tracking = trackingField.value.trim();
        let isValid = true;

        if (!tracking) {
          trackingError?.classList.remove("hidden");
          trackingField.setAttribute("aria-invalid", "true");
          trackingField.focus();
          isValid = false;
        } else {
          trackingField.removeAttribute("aria-invalid");
        }

        if (!contentDescription) {
          descriptionError?.classList.remove("hidden");
          descriptionField.setAttribute("aria-invalid", "true");
          if (isValid) descriptionField.focus();
          isValid = false;
        } else {
          descriptionField.removeAttribute("aria-invalid");
        }

        if (
          !valueField.value ||
          !Number.isFinite(declaredValue) ||
          declaredValue <= 0
        ) {
          valueError?.classList.remove("hidden");
          valueField.setAttribute("aria-invalid", "true");
          if (isValid) valueField.focus();
          isValid = false;
        } else {
          valueField.removeAttribute("aria-invalid");
        }

        if (!isValid) return;
        if (!preAlertEndpoint) {
          showPreAlertError(genericErrorMessage);
          return;
        }

        setPreAlertLoading(true);

        try {
          const response = await fetch(preAlertEndpoint, {
            method: "POST",
            headers: {
              Accept: "application/json",
              "Content-Type": "application/json",
            },
            credentials: "include",
            body: JSON.stringify({
              external_tracking: tracking,
              content_description: contentDescription,
              declared_value: declaredValue,
              shipping_type: shippingTypeField.value,
            }),
          });

          const responseData = await readJsonResponse(response);
          const apiMessage =
            isRecord(responseData) && hasString(responseData.message)
              ? responseData.message
              : "";

          if (response.status === 401) {
            const message = [
              "Tu sesión expiró. Vuelve a iniciar sesión para registrar la prealerta.",
              apiMessage,
            ]
              .filter(Boolean)
              .join(" ");
            showPreAlertError(message, true);
            setPreAlertLoading(false);
            return;
          }

          if (!response.ok) {
            const validationMessage =
              isRecord(responseData) && isRecord(responseData.errors)
                ? Object.values(responseData.errors)
                    .flatMap((errors) =>
                      Array.isArray(errors) ? errors : [errors],
                    )
                    .find(hasString)
                : "";
            const message =
              [apiMessage, validationMessage]
                .filter(
                  (part, index, messages) =>
                    Boolean(part) && messages.indexOf(part) === index,
                )
                .join(" ") ||
              "No se pudo registrar la prealerta. Intenta nuevamente.";
            showPreAlertError(message);
            setPreAlertLoading(false);
            return;
          }

          preAlertForm.reset();
          preAlertError?.classList.add("hidden");
          preAlertLoginAction?.classList.add("hidden");
          if (preAlertSuccess) {
            preAlertSuccess.textContent =
              apiMessage || "Prealerta registrada correctamente.";
            preAlertSuccess.classList.remove("hidden");
          }
          await loadPreAlertHistory();
        } catch {
          showPreAlertError(
            "No se pudo conectar con el servidor. Revisa tu conexión e intenta nuevamente.",
          );
        } finally {
          setPreAlertLoading(false);
        }
      });
    }

    preAlertLoginAction?.addEventListener("click", () => {
      localStorage.removeItem("caricoxpress_locker");
      accessPanel?.classList.remove("hidden");
      content?.classList.add("hidden");
      window.scrollTo({top: 0, behavior: "smooth"});
      document.getElementById("access-email")?.focus({preventScroll: true});
    });

    copyCustomerCodeButton?.addEventListener("click", async () => {
      const customerCode = document
        .getElementById("shipping-warehouse_reference")
        ?.textContent?.trim();
      if (!customerCode) return;

      try {
        await navigator.clipboard.writeText(customerCode);
        if (copyCustomerCodeStatus) {
          copyCustomerCodeStatus.textContent = "Código copiado";
        }
      } catch {
        if (copyCustomerCodeStatus) {
          copyCustomerCodeStatus.textContent =
            "No se pudo copiar. Selecciona y copia el código.";
        }
      }
    });

    const renderLocker = (data: LockerAccessResponse) => {
      const shippingData = data.shipping_data;
      const customerReference =
        `${data.customer_name} ${shippingData.warehouse_reference}`.trim();

      if (cardLockerCode) {
        cardLockerCode.textContent = data.locker_code;
      }

      setText("shipping-warehouse_reference", customerReference);
      setText("postal-customer-reference", customerReference);
      setText("postal-address_line_1", shippingData.address_line_1);
      setText("postal-city", shippingData.city);
      setText("postal-state", shippingData.state);
      setText("postal-postal_code", shippingData.postal_code);
      setText("postal-country", shippingData.country);

      accessPanel?.classList.add("hidden");
      content?.classList.remove("hidden");
      localStorage.setItem("caricoxpress_locker", JSON.stringify(data));
      void loadPreAlertHistory();
    };

    form.addEventListener("submit", async (event: Event) => {
      event.preventDefault();
      if (submitButton.disabled) return;

      clearErrors();

      if (!form.checkValidity()) {
        showNativeFieldErrors();
        return;
      }

      if (!accessEndpoint) {
        setError(genericErrorMessage);
        return;
      }

      const emailField = form.elements.namedItem("email");
      const passwordField = form.elements.namedItem("password");
      if (!(emailField instanceof HTMLInputElement)) return;
      if (!(passwordField instanceof HTMLInputElement)) return;

      setLoading(true);
      localStorage.removeItem("caricoxpress_locker");

      try {
        const response = await fetch(accessEndpoint, {
          method: "POST",
          headers: {
            Accept: "application/json",
          },
          credentials: "include",
          body: new URLSearchParams({
            email: emailField.value,
            password: passwordField.value,
          }),
        });

        if (response.status === 401) {
          setError(invalidCredentialsMessage);
          setLoading(false);
          return;
        }

        if (response.status === 429) {
          setError(rateLimitMessage);
          setLoading(false);
          return;
        }

        if (!response.ok) {
          setError(genericErrorMessage);
          setLoading(false);
          return;
        }

        const data = await readJsonResponse(response);
        if (!isValidLockerResponse(data)) {
          setError(genericErrorMessage);
          setLoading(false);
          return;
        }

        renderLocker(data);
      } catch {
        setError(genericErrorMessage);
        setLoading(false);
      }
    });

    const restoreSession = async () => {
      const storedLocker = localStorage.getItem("caricoxpress_locker");
      const hadStoredLocker = storedLocker !== null;
      if (!sessionEndpoint) {
        localStorage.removeItem("caricoxpress_locker");
        return;
      }

      try {
        const response = await fetch(sessionEndpoint, {
          headers: {Accept: "application/json"},
          credentials: "include",
        });

        if (response.status === 401) {
          localStorage.removeItem("caricoxpress_locker");
          if (hadStoredLocker) {
            setError(
              "Tu sesión expiró. Inicia sesión nuevamente para consultar tu casillero.",
            );
          }
          return;
        }

        if (!response.ok) {
          localStorage.removeItem("caricoxpress_locker");
          if (hadStoredLocker) setError(genericErrorMessage);
          return;
        }

        const data = await readJsonResponse(response);
        if (isValidLockerResponse(data)) {
          renderLocker(data);
        } else {
          localStorage.removeItem("caricoxpress_locker");
          if (hadStoredLocker) setError(genericErrorMessage);
        }
      } catch {
        localStorage.removeItem("caricoxpress_locker");
        if (hadStoredLocker) setError(genericErrorMessage);
      }
    };

    void restoreSession();

    closeLockerButton?.addEventListener("click", async () => {
      localStorage.removeItem("caricoxpress_locker");
      if (logoutEndpoint) {
        await fetch(logoutEndpoint, {
          method: "POST",
          headers: {Accept: "application/json"},
          credentials: "include",
        }).catch(() => undefined);
      }

      window.location.replace("/mi-casillero");
    });
  };

  document.addEventListener("astro:page-load", initializeLockerPage);
</script>
