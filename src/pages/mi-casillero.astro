---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Banner from "../components/Banner.astro";

const fieldClass =
  "min-h-11 rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20";
---

<BaseLayout
  title="Mi casillero CaricoXpress"
  description="Consulta los datos públicos de tu casillero CaricoXpress con tu correo y contraseña."
>
  <Fragment slot="head">
    <meta
      name="robots"
      content="noindex, nofollow"
    />
  </Fragment>

  <Header slot="header" />

  <Banner title="Mi casillero" />

  <section class="bg-background py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div
        id="access-panel"
        class="mx-auto max-w-3xl rounded-lg border border-border bg-background p-6 shadow-sm sm:p-8"
      >
        <div class="text-center">
          <p class="text-sm font-bold uppercase text-accent">Mi CaricoXpress</p>
          <h1 class="mt-3 font-heading text-h2 font-bold uppercase text-text">
            Consulta tu casillero
          </h1>
          <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-text-muted">
            Ingresa el correo y la contraseña que utilizaste al crear tu
            casillero.
          </p>
        </div>

        <div
          id="registration-success-message"
          class="mt-6 hidden rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700"
          role="status"
          aria-live="polite"
        >
          Tu casillero fue creado correctamente. Ingresa con tu correo y
          contraseña para consultar tus datos de envío.
        </div>

        <div
          id="access-error"
          class="mt-6 hidden rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
          role="alert"
          aria-live="assertive"
          tabindex="-1"
        >
        </div>

        <form
          id="locker-access-form"
          method="post"
          class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2"
          novalidate
        >
          <label
            for="access-email"
            class="flex flex-col gap-1.5"
          >
            <span class="text-sm font-medium text-text">
              Correo electrónico <span
                class="text-accent"
                aria-hidden="true"
              >
                *
              </span>
            </span>
            <input
              id="access-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              class={fieldClass}
              aria-describedby="access-email-error"
            />
            <span
              id="access-email-error"
              class="hidden text-sm text-red-600"
            >
              Indica un correo electrónico válido.
            </span>
          </label>

          <label
            for="access-password"
            class="flex flex-col gap-1.5"
          >
            <span class="text-sm font-medium text-text">
              Contraseña <span
                class="text-accent"
                aria-hidden="true"
              >
                *
              </span>
            </span>
            <div class="relative">
              <input
                id="access-password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                class={`${fieldClass} w-full !pr-12`}
                aria-describedby="access-password-error"
              />
              <button
                type="button"
                class="absolute inset-y-0 right-0 inline-flex min-h-11 w-11 cursor-pointer items-center justify-center rounded-r-md text-text-muted transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                data-password-toggle="access-password"
                aria-label="Mostrar contraseña"
                title="Mostrar contraseña"
                aria-pressed="false"
              >
                <svg
                  data-password-show-icon
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                  <circle
                    cx="12"
                    cy="12"
                    r="3"
                  >
                  </circle>
                </svg>
                <svg
                  data-password-hide-icon
                  aria-hidden="true"
                  class="hidden"
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M10.733 5.076A10.744 10.744 0 0 1 12 5c7 0 10 7 10 7a13.163 13.163 0 0 1-1.67 2.68"
                  >
                  </path>
                  <path
                    d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"
                  >
                  </path>
                  <path d="M2 2l20 20"></path>
                  <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                </svg>
              </button>
            </div>
            <span
              id="access-password-error"
              class="hidden text-sm text-red-600"
            >
              Indica tu contraseña.
            </span>
          </label>

          <div
            class="flex flex-col gap-3 pt-2 sm:col-span-2 sm:flex-row sm:items-center"
          >
            <button
              id="access-submit"
              type="submit"
              class="inline-flex min-h-11 cursor-pointer items-center justify-center rounded-md bg-accent px-8 py-3 text-base font-bold uppercase text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-not-allowed disabled:opacity-70"
            >
              <span data-label-idle>Ver mi casillero</span>
              <span
                data-label-loading
                class="hidden"
              >
                Consultando...
              </span>
            </button>
            <p
              id="access-status"
              class="text-sm text-text-muted"
              aria-live="polite"
            >
            </p>
          </div>
        </form>
      </div>

      <div
        id="locker-content"
        class="hidden"
      >
        <article
          class="mx-auto max-w-4xl overflow-hidden rounded-xl border border-border bg-background shadow-xl shadow-primary/10"
          aria-labelledby="locker-card-title"
        >
          <header class="bg-primary px-6 py-6 text-primary-fg sm:px-8">
            <div class="flex items-center justify-between gap-5">
              <div class="flex items-center gap-4">
                <svg
                  aria-hidden="true"
                  class="h-10 w-10 shrink-0 text-primary-fg sm:h-12 sm:w-12"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 48 48"
                  fill="none"
                >
                  <rect
                    x="5"
                    y="9"
                    width="38"
                    height="30"
                    rx="5"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                  </rect>
                  <circle
                    cx="17"
                    cy="21"
                    r="5"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                  </circle>
                  <path
                    d="M9.5 34c.8-4.4 3.3-6.5 7.5-6.5s6.7 2.1 7.5 6.5M29 19h9M29 25h9M29 31h6"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                  >
                  </path>
                </svg>
                <div>
                  <p
                    id="locker-card-title"
                    class="font-heading text-3xl font-bold uppercase tracking-wide sm:text-4xl"
                  >
                    Carnet de cliente
                  </p>
                </div>
              </div>
              <div class="flex shrink-0 flex-col items-end gap-y-3 text-right">
                <div>
                  <p
                    class="text-xs font-bold uppercase tracking-wider text-primary-fg/80"
                  >
                    N.º de casillero
                  </p>
                  <p
                    id="card-locker-code-header"
                    class="mt-1 font-heading text-2xl font-black leading-none text-primary-fg sm:text-3xl"
                  >
                  </p>
                </div>
                <span
                  class="inline-flex rounded-full border border-primary-fg/30 bg-green-600 px-3 py-1 text-xs font-bold uppercase tracking-wide text-primary-fg shadow-sm shadow-green-400"
                >
                  Activo
                </span>
              </div>
            </div>
          </header>

          <div class="bg-surface px-6 py-8 sm:px-8 lg:px-10">
            <section
              class="grid grid-cols-1 gap-6 border-b border-border pb-8"
              aria-labelledby="locker-owner-title"
            >
              <div>
                <p
                  id="locker-owner-title"
                  class="text-xs font-bold uppercase tracking-wider text-accent"
                >
                  Código de cliente
                </p>
                <p
                  id="shipping-warehouse_reference"
                  class="break-words rounded-md border-l-4 border-accent bg-background px-5 py-6 font-heading text-3xl font-bold text-primary shadow-sm sm:px-7 sm:py-7 sm:text-4xl"
                >
                </p>
                <button
                  id="copy-customer-code"
                  type="button"
                  class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-bold text-primary-fg transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                  aria-describedby="copy-customer-code-status"
                >
                  <svg
                    aria-hidden="true"
                    class="h-4 w-4"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect
                      x="8"
                      y="8"
                      width="13"
                      height="13"
                      rx="2"
                    >
                    </rect>
                    <path
                      d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"
                    >
                    </path>
                  </svg>
                  <span data-copy-label>Copiar código de cliente</span>
                </button>
                <span
                  id="copy-customer-code-status"
                  class="ml-3 text-sm text-text-muted"
                  role="status"
                  aria-live="polite"
                >
                </span>
              </div>
            </section>

            <section
              class="border-b border-border py-8"
              aria-labelledby="shipping-data-title"
            >
              <div>
                <h2
                  id="shipping-data-title"
                  class="font-heading text-2xl font-bold text-text"
                >
                  Datos para compras y envíos
                </h2>
                <p class="mt-3 leading-relaxed text-text-muted">
                  Usa estos datos exactamente como aparecen al comprar en
                  tiendas de Estados Unidos o al enviar paquetes al almacén en
                  Miami.
                </p>
              </div>

              <div
                class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-[1.2fr_0.8fr]"
              >
                <div
                  class="rounded-lg border border-border bg-background p-6 shadow-sm"
                  aria-labelledby="postal-block-title"
                >
                  <p
                    id="postal-block-title"
                    class="text-xs font-bold uppercase tracking-wider text-accent"
                  >
                    Dirección de su warehouse en CaricoXpress
                  </p>
                  <div
                    class="mt-4 space-y-4 rounded-md bg-surface p-4 text-primary sm:p-5"
                  >
                    <div class="flex min-w-0 items-start gap-3">
                      <svg
                        aria-hidden="true"
                        class="mt-0.5 h-5 w-5 shrink-0 text-accent"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle
                          cx="12"
                          cy="8"
                          r="4"
                        >
                        </circle>
                        <path d="M5 21a7 7 0 0 1 14 0"></path>
                      </svg>
                      <div class="min-w-0">
                        <p
                          id="postal-customer-reference"
                          class="whitespace-nowrap text-[clamp(0.55rem,1.55vw,1rem)] font-bold leading-tight"
                        >
                        </p>
                        <p class="mt-1 text-xs text-text-muted">
                          (Debe aparecer exactamente así)
                        </p>
                      </div>
                    </div>
                    <div
                      class="flex items-start gap-3 border-t border-border pt-3"
                    >
                      <svg
                        aria-hidden="true"
                        class="mt-0.5 h-5 w-5 shrink-0 text-accent"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path
                          d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"
                        >
                        </path>
                        <circle
                          cx="12"
                          cy="10"
                          r="2.5"
                        >
                        </circle>
                      </svg>
                      <div
                        class="min-w-0 space-y-1 font-heading text-sm font-semibold leading-6 sm:text-base"
                      >
                        <p
                          id="postal-address_line_1"
                          class="break-words"
                        >
                        </p>
                        <p>
                          <span id="postal-city"></span><span
                            id="postal-city-comma"
                          >
                            ,
                          </span><span id="postal-state"></span>
                          <span id="postal-postal_code"></span>
                        </p>
                      </div>
                    </div>
                    <div
                      class="flex items-center gap-3 border-t border-border pt-3"
                    >
                      <svg
                        aria-label="Bandera de Estados Unidos"
                        role="img"
                        class="h-5 w-7 shrink-0 rounded-sm shadow-sm"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 19 10"
                      >
                        <rect
                          width="19"
                          height="10"
                          fill="#fff"
                        >
                        </rect>
                        <path
                          fill="#b22234"
                          d="M0 0h19v.77H0zm0 1.54h19v.77H0zm0 1.54h19v.77H0zm0 1.54h19v.77H0zm0 1.54h19v.77H0zm0 1.54h19v.77H0z"
                        >
                        </path>
                        <path
                          fill="#3c3b6e"
                          d="M0 0h8v5.38H0z"
                        >
                        </path>
                        <path
                          fill="#fff"
                          d="m1 .6.2.45.5.04-.38.3.12.48L1 .61zm1.5 0 .2.45.5.04-.38.3.12.48-0.44-.26-.44.26.12-.48-.38-.3.5-.04zm1.5 0 .2.45.5.04-.38.3.12.48-.44-.26-.44.26.12-.48-.38-.3.5-.04zm1.5 0 .2.45.5.04-.38.3.12.48-.44-.26-.44.26.12-.48-.38-.3.5-.04zm1.5 0 .2.45.5.04-.38.3.12.48-.44-.26-.44.26.12-.48-.38-.3.5-.04zM1 2l.2.45.5.04-.38.3.12.48L1 3.01l-.44.26.12-.48-.38-.3.5-.04zm1.5 0 .2.45.5.04-.38.3.12.48-.44-.26-.44.26.12-.48-.38-.3.5-.04zm1.5 0 .2.45.5.04-.38.3.12.48-.44-.26-.44.26.12-.48-.38-.3.5-.04zm1.5 0 .2.45.5.04-.38.3.12.48-.44-.26-.44.26.12-.48-.38-.3.5-.04zm1.5 0 .2.45.5.04-.38.3.12.48-.44-.26-.44.26.12-.48-.38-.3.5-.04zM1 3.4l.2.45.5.04-.38.3.12.48L1 4.41l-.44.26.12-.48-.38-.3.5-.04zm1.5 0 .2.45.5.04-.38.3.12.48-.44-.26-.44.26.12-.48-.38-.3.5-.04zm1.5 0 .2.45.5.04-.38.3.12.48-.44-.26-.44.26.12-.48-.38-.3.5-.04zm1.5 0 .2.45.5.04-.38.3.12.48-.44-.26-.44.26.12-.48-.38-.3.5-.04zm1.5 0 .2.45.5.04-.38.3.12.48-.44-.26-.44.26.12-.48-.38-.3.5-.04z"
                        >
                        </path>
                      </svg>
                      <p
                        id="postal-country"
                        class="font-heading text-sm font-semibold sm:text-base"
                      >
                      </p>
                    </div>
                  </div>
                </div>

                <aside
                  class="rounded-lg border border-yellow-300 bg-yellow-100 p-5 text-sm leading-relaxed text-yellow-950 shadow-sm sm:p-6"
                  aria-labelledby="shipping-note-title"
                >
                  <div class="flex items-start gap-3">
                    <span
                      aria-hidden="true"
                      class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-400 text-xl font-black leading-none text-white"
                    >
                      !
                    </span>
                    <h3
                      id="shipping-note-title"
                      class="font-heading text-base font-bold leading-snug text-primary sm:text-lg"
                    >
                      Importante: coloque estos datos exactamente como aparecen
                    </h3>
                  </div>

                  <p
                    class="mt-3 border-t border-yellow-300 pt-3 leading-relaxed"
                  >
                    Por favor, incluya también las instrucciones de entrega para
                    evitar confusiones con repartidores o transportistas.
                  </p>
                  <p class="mt-3 font-semibold leading-relaxed">
                    Esto nos ayuda a recibir su compra de forma más rápida y
                    precisa.
                  </p>
                </aside>
              </div>
            </section>

            <section
              class="border-b border-border py-8"
              aria-labelledby="prealert-title"
            >
              <div>
                <h2
                  id="prealert-title"
                  class="font-heading text-2xl font-bold text-text"
                >
                  Registrar una prealerta
                </h2>
                <p class="mt-2 leading-relaxed text-text-muted">
                  Avísanos sobre tu compra para identificarla al llegar al
                  warehouse.
                </p>
              </div>

              <div
                id="prealert-success"
                class="mt-5 hidden rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800"
                role="status"
                aria-live="polite"
              >
              </div>
              <div
                id="prealert-error"
                class="mt-5 hidden rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
                role="alert"
                aria-live="assertive"
              >
                <p id="prealert-error-message"></p>
                <button
                  id="prealert-login-action"
                  type="button"
                  class="mt-3 hidden font-bold text-primary underline underline-offset-2"
                >
                  Volver a iniciar sesión
                </button>
              </div>

              <form
                id="prealert-form"
                class="mx-auto mt-6 w-full max-w-2xl space-y-5 rounded-lg border border-border bg-background p-5 shadow-sm sm:p-6"
                novalidate
              >
                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                  <label
                    for="prealert-tracking"
                    class="flex flex-col gap-1.5 sm:col-span-2"
                  >
                    <span class="text-sm font-medium text-text">
                      Número de tracking <span
                        class="text-accent"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </span>
                    <input
                      id="prealert-tracking"
                      name="external_tracking"
                      type="text"
                      autocomplete="off"
                      placeholder="Ingrese número de tracking"
                      required
                      class={fieldClass}
                      aria-describedby="prealert-tracking-error"
                    />
                    <span
                      id="prealert-tracking-error"
                      class="hidden text-sm text-red-600"
                    >
                      Ingresa el número de tracking.
                    </span>
                  </label>

                  <label
                    for="prealert-description"
                    class="flex flex-col gap-1.5 sm:col-span-2"
                  >
                    <span class="text-sm font-medium text-text">
                      Descripción del producto <span
                        class="text-accent"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </span>
                    <textarea
                      id="prealert-description"
                      name="content_description"
                      rows="3"
                      required
                      class={`${fieldClass} min-h-24 resize-y`}
                      aria-describedby="prealert-description-hint prealert-description-error"
                    >
                    </textarea>
                    <span
                      id="prealert-description-hint"
                      class="text-sm leading-relaxed text-text-muted"
                    >
                      Indica qué compraste y, si aplica, cantidad o modelo. Ej.:
                      audífonos inalámbricos, 1 unidad.
                    </span>
                    <span
                      id="prealert-description-error"
                      class="hidden text-sm text-red-600"
                    >
                      Describe el producto.
                    </span>
                  </label>

                  <label
                    for="prealert-value"
                    class="flex flex-col gap-1.5"
                  >
                    <span class="text-sm font-medium text-text">
                      Monto del producto (USD) <span
                        class="text-accent"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </span>
                    <input
                      id="prealert-value"
                      name="declared_value"
                      type="number"
                      min="0.01"
                      step="0.01"
                      inputmode="decimal"
                      required
                      class={fieldClass}
                      aria-describedby="prealert-value-error"
                    />
                    <span
                      id="prealert-value-error"
                      class="hidden text-sm text-red-600"
                    >
                      Ingresa un monto válido mayor que cero.
                    </span>
                  </label>

                  <label
                    for="prealert-shipping-type"
                    class="flex flex-col gap-1.5"
                  >
                    <span class="text-sm font-medium text-text">
                      Tipo de envío
                    </span>
                    <select
                      id="prealert-shipping-type"
                      name="shipping_type"
                      class={fieldClass}
                    >
                      <option value="air">Aéreo</option>
                      <option value="sea">Marítimo</option>
                      <option
                        value="undefined"
                        selected
                      >
                        Por definir
                      </option>
                    </select>
                  </label>
                </div>

                <div class="border-t border-border pt-5">
                  <button
                    id="prealert-submit"
                    type="submit"
                    class="inline-flex min-h-11 w-full items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
                  >
                    <span data-prealert-idle>Registrar prealerta</span>
                    <span
                      data-prealert-loading
                      class="hidden"
                    >
                      Guardando...
                    </span>
                  </button>
                </div>
              </form>

              <section
                class="mt-12"
                aria-labelledby="prealert-history-title"
              >
                <h3
                  id="prealert-history-title"
                  class="font-heading text-xl font-bold text-text"
                >
                  Historial de prealertas
                </h3>
                <p
                  id="prealert-history-loading"
                  class="mt-4 text-sm text-text-muted"
                  role="status"
                  aria-live="polite"
                >
                  Cargando prealertas...
                </p>
                <p
                  id="prealert-history-empty"
                  class="mt-4 hidden rounded-md border border-border bg-background px-4 py-3 text-sm text-text-muted"
                >
                  Todavía no tienes prealertas registradas.
                </p>
                <p
